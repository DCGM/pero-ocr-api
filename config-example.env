# -------------------------------------------------------------------
# PERO-OCR-API  —  Environment configuration
# Copy this file to `.env` and adjust the values.
# -------------------------------------------------------------------

# Database connection (async SQLAlchemy URL)
# For PostgreSQL:  postgresql+asyncpg://user:password@host:5432/dbname
# For SQLite:      sqlite+aiosqlite:///./pero_api.db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pero_api
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Application
DEBUG=false
APPLICATION_ROOT=

# Filesystem paths (absolute or relative to working directory)
PROCESSED_REQUESTS_FOLDER=./processed_requests
MODELS_FOLDER=./models
UPLOAD_IMAGES_FOLDER=./images
ALLOWED_IMAGE_EXTENSIONS=["jpg","jpeg","png"]

# Email notifications (JSON array of addresses, empty to disable)
EMAIL_NOTIFICATION_ADDRESSES=[]
MAX_EMAIL_FREQUENCY=3600
MAIL_SERVER=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
